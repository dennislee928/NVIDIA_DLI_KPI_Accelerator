{
  "manifest_version": 3,
  "name": "NVIDIA DLI KPI Accelerator",
  "version": "1.5",
  "description": "NVIDIA DLI / CrowdStrike University / AttackIQ Academy / Snyk Learn 課程自動化測試工具",
  "permissions": [
    "storage",
    "activeTab",
    "scripting",
    "webNavigation"
  ],
  "host_permissions": [
    "https://learn.nvidia.com/*",
    "https://learn.learn.nvidia.com/*",
    "https://university.crowdstrike.com/*",
    "https://*.crowdstrike.com/*",
    "https://*.articulate.com/*",
    "https://rise.articulate.com/*",
    "https://*.attackiq.com/*",
    "https://learn.snyk.io/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Course Accelerator"
  },
  "content_scripts": [
    {
      "matches": ["https://learn.nvidia.com/courses/course*"],
      "js": ["content.js"]
    },
    {
      "matches": [
        "https://university.crowdstrike.com/*",
        "https://*.crowdstrike.com/*",
        "https://*.articulate.com/*",
        "https://rise.articulate.com/*"
      ],
      "js": ["content-crowdstrike.js"],
      "run_at": "document_idle",
      "all_frames": true,
      "match_about_blank": true
    },
    {
      "matches": ["https://*.attackiq.com/*"],
      "js": ["content-attackiq.js"],
      "run_at": "document_idle",
      "all_frames": true,
      "match_about_blank": true
    },
    {
      "matches": ["https://learn.snyk.io/*"],
      "js": ["content-snyk.js"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
